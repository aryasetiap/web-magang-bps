// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Generator: Defines what to generate from this schema.
// In this case, it's the Prisma Client for TypeScript.
generator client {
  provider = "prisma-client-js"
}

// 2. Datasource: Specifies the database connection details.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Loads the URL from the .env file
}

// 3. Enums: Defines custom types for status fields, ensuring data consistency.
enum StatusInternship {
  pending
  diterima
  ditolak
}

enum StatusLogbook {
  draft
  submitted
  reviewed
}

enum StatusFinalProject {
  draft
  submitted
  reviewed
  accepted
  revisi
}

enum StatusSubmission {
  not_submitted
  submitted
  reviewed
  revisi // Tambahkan status revisi
}

enum AttendanceStatus {
  hadir
  sakit
  izin
  tanpa_keterangan
}

enum CertificateStatus {
  generated
  signed
  issued
}

// 4. Data Models: Defines the tables in your database.

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  profilePhoto  String? // Field baru untuk foto profil
  namaLengkap   String?
  nimNisn       String?
  asalInstitusi String?
  jurusanProdi  String?
  nomorTelepon  String?
  alamat        String?
  roleId        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  role Role @relation(fields: [roleId], references: [id])

  // Relations - BERSIHKAN DUPLIKASI
  // User sebagai applicant (one-to-one)
  internshipApplication InternshipApplication? @relation("ApplicantApplication")

  // User sebagai verifier (one-to-many)
  verifiedApplications InternshipApplication[] @relation("VerifierApplications")

  // User attendance records
  attendances Attendance[]

  // User logbook entries
  logbooks Logbook[]

  // User created tasks (as staff/coordinator)
  createdTasks Task[] @relation("CreatedTasks")

  // User task assignments
  taskAssignments TaskAssignment[]

  // User submissions
  submissions Submission[]

  // User final projects (as student)
  finalProjects FinalProject[]

  // User reviewed final projects (as reviewer)
  reviewedFinalProjects FinalProject[] @relation("FinalProjectReviewer")

  // User uploaded documents
  uploadedDocuments Document[]

  educationStatus String? // Status pendidikan
  activityType    String? // Jenis kegiatan
  activityStart   DateTime? // Tanggal mulai kegiatan
  activityEnd     DateTime? // Tanggal selesai kegiatan
  Certificate     Certificate?

  isEmailVerified         Boolean   @default(false)
  emailOtp                String? // kode OTP
  emailOtpExpires         DateTime? // waktu kadaluarsa OTP
  lastOtpSentAt           DateTime? // waktu terakhir OTP dikirim
  resetPasswordOtp        String?
  resetPasswordOtpExpires DateTime?

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  // --- Relations ---
  // A role can be assigned to many users
  users User[]
}

model InternshipApplication {
  id                Int              @id @default(autoincrement())
  status            StatusInternship @default(pending)
  cvPath            String?          @map("cv_path") // Ubah jadi opsional
  transcriptPath    String           @map("transcript_path")
  requestLetterPath String           @map("request_letter_path")
  verifiedAt        DateTime?        @map("verified_at")
  feedback          String?          @db.Text
  startDate         DateTime?
  endDate           DateTime?

  // --- Relations ---
  applicant User @relation("ApplicantApplication", fields: [userId], references: [id])
  userId    Int  @unique @map("user_id")

  verifier   User? @relation("VerifierApplications", fields: [verifiedBy], references: [id])
  verifiedBy Int?  @map("verified_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internship_applications")
}

model Attendance {
  id                Int       @id @default(autoincrement())
  clockIn           DateTime? @map("clock_in")
  clockOut          DateTime? @map("clock_out")
  ipAddress         String?   @map("ip_address")
  latitude          Float?
  longitude         Float?
  clockOutLatitude  Float?    @map("clock_out_latitude")
  clockOutLongitude Float?    @map("clock_out_longitude")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // --- New fields for izin/sakit ---
  status            AttendanceStatus @default(hadir)
  reasonDescription String?          @db.Text
  proofFilePath     String?
  submittedAt       DateTime?
  validatedBy       Int?
  validatedAt       DateTime?

  // --- Relations ---
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("attendances")
}

model Logbook {
  id      Int           @id @default(autoincrement())
  logDate DateTime      @map("log_date") @db.Date
  content String        @db.Text
  status  StatusLogbook @default(draft)

  // --- Relations ---
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("logbooks")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  deadline    DateTime
  filePath    String?   @map("file_path") // <--- Tambahkan ini
  deletedAt   DateTime? // Soft delete

  // --- Relations ---
  // A task is created by one user (staff/coordinator)
  creator   User @relation("CreatedTasks", fields: [createdBy], references: [id])
  createdBy Int  @map("created_by")

  // A task can have many submissions
  submissions Submission[]

  // A task can be assigned to many users via the TaskAssignment table
  assignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  // --- Relations ---
  task   Task @relation(fields: [taskId], references: [id])
  taskId Int  @map("task_id")

  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  // --- Composite Primary Key ---
  @@id([taskId, userId])
  @@map("task_assignments")
}

model Submission {
  id          Int              @id @default(autoincrement())
  filePath    String?          @map("file_path")
  grade       Float?
  feedback    String?
  status      StatusSubmission @default(not_submitted)
  gradedBy    Int?
  gradedAt    DateTime?
  deletedAt   DateTime?
  isLate      Boolean          @default(false)
  description String? // <--- Tambahkan field ini

  // --- Relations ---
  task   Task @relation(fields: [taskId], references: [id])
  taskId Int  @map("task_id")

  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("submissions")
}

model FinalProject {
  id          Int                @id @default(autoincrement())
  title       String
  description String?            @db.Text
  filePath    String?            @map("file_path")
  status      StatusFinalProject @default(draft)
  grade       Float?
  feedback    String?            @db.Text
  submittedAt DateTime?          @map("submitted_at")
  reviewedAt  DateTime?          @map("reviewed_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // --- Relations ---
  user         User  @relation(fields: [userId], references: [id])
  userId       Int   @map("user_id")
  reviewedBy   User? @relation("FinalProjectReviewer", fields: [reviewedById], references: [id])
  reviewedById Int?  @map("reviewed_by_id")

  @@map("final_projects")
}

model Document {
  id       Int    @id @default(autoincrement())
  title    String
  filePath String @map("file_path")

  // --- Relations ---
  uploader   User? @relation(fields: [uploadedBy], references: [id])
  uploadedBy Int?  @map("uploaded_by")

  @@map("documents")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    Int
  userId      Int
  description String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Certificate {
  id                Int               @id @default(autoincrement())
  certificateNumber String            @unique
  userId            Int               @unique
  internName        String
  educationalStatus String
  institusi         String
  predicate         String
  namaKegiatan      String
  activityPeriod    String
  tglSertifikat     DateTime
  namaKepalaBPS     String
  nipKepalaBPS      String
  templatePath      String
  signedFilePath    String?
  status            CertificateStatus @default(generated)
  generatedAt       DateTime          @default(now())
  signedAt          DateTime?
  issuedAt          DateTime?
  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("certificates")
}
