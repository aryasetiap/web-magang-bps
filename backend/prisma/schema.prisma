// Prisma Schema untuk Web Magang BPS
// File ini mendefinisikan struktur database, enum, dan relasi antar model.
// Dokumentasi ditulis dalam Bahasa Indonesia untuk memudahkan pengembangan tim.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum status magang, memastikan konsistensi data status pengajuan magang.
enum StatusInternship {
  pending
  diterima
  ditolak
}

// Enum status logbook harian.
enum StatusLogbook {
  draft
  submitted
  reviewed
}

// Enum status tugas akhir.
enum StatusFinalProject {
  draft
  submitted
  reviewed
  accepted
  revisi
}

// Enum status pengumpulan tugas.
enum StatusSubmission {
  not_submitted
  submitted
  reviewed
  revisi
}

// Enum status kehadiran.
enum AttendanceStatus {
  hadir
  sakit
  izin
  tanpa_keterangan
}

// Enum status sertifikat.
enum CertificateStatus {
  generated
  signed
  issued
}

/// Model User
/// Menyimpan data pengguna, baik mahasiswa, staf, maupun koordinator.
/// Relasi: Role, InternshipApplication, Attendance, Logbook, Task, Submission, FinalProject, Document, Certificate.
model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  profilePhoto  String?
  namaLengkap   String?
  nimNisn       String?
  asalInstitusi String?
  jurusanProdi  String?
  nomorTelepon  String?
  alamat        String?
  roleId        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relasi ke Role
  role Role @relation(fields: [roleId], references: [id])

  // Relasi ke pengajuan magang sebagai applicant (satu user satu pengajuan)
  internshipApplication InternshipApplication? @relation("ApplicantApplication")

  // Relasi ke pengajuan magang yang diverifikasi (user sebagai verifier)
  verifiedApplications InternshipApplication[] @relation("VerifierApplications")

  // Relasi ke data kehadiran
  attendances Attendance[]

  // Relasi ke logbook harian
  logbooks Logbook[]

  // Relasi ke tugas yang dibuat (user sebagai pembuat tugas)
  createdTasks Task[] @relation("CreatedTasks")

  // Relasi ke penugasan tugas (user sebagai penerima tugas)
  taskAssignments TaskAssignment[]

  // Relasi ke pengumpulan tugas
  submissions Submission[]

  // Relasi ke tugas akhir (user sebagai mahasiswa)
  finalProjects FinalProject[]

  // Relasi ke tugas akhir yang direview (user sebagai reviewer)
  reviewedFinalProjects FinalProject[] @relation("FinalProjectReviewer")

  // Relasi ke dokumen yang diunggah
  uploadedDocuments Document[]

  educationStatus String?
  activityType    String?
  activityStart   DateTime?
  activityEnd     DateTime?
  Certificate     Certificate?

  isGraduated Boolean @default(false)

  isEmailVerified         Boolean   @default(false)
  emailOtp                String?
  emailOtpExpires         DateTime?
  lastOtpSentAt           DateTime?
  resetPasswordOtp        String?
  resetPasswordOtpExpires DateTime?

  @@map("users")
}

/// Model Role
/// Menyimpan data peran pengguna (mahasiswa, staf, koordinator).
model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]
}

/// Model InternshipApplication
/// Menyimpan data pengajuan magang oleh mahasiswa.
model InternshipApplication {
  id                Int              @id @default(autoincrement())
  status            StatusInternship @default(pending)
  cvPath            String?          @map("cv_path")
  transcriptPath    String           @map("transcript_path")
  requestLetterPath String           @map("request_letter_path")
  verifiedAt        DateTime?        @map("verified_at")
  feedback          String?          @db.Text
  startDate         DateTime?
  endDate           DateTime?

  // Relasi ke user sebagai applicant
  applicant User @relation("ApplicantApplication", fields: [userId], references: [id])
  userId    Int  @unique @map("user_id")

  // Relasi ke user sebagai verifier
  verifier   User? @relation("VerifierApplications", fields: [verifiedBy], references: [id])
  verifiedBy Int?  @map("verified_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internship_applications")
}

/// Model Attendance
/// Menyimpan data kehadiran harian mahasiswa.
model Attendance {
  id                Int       @id @default(autoincrement())
  clockIn           DateTime? @map("clock_in")
  clockOut          DateTime? @map("clock_out")
  ipAddress         String?   @map("ip_address")
  latitude          Float?
  longitude         Float?
  clockOutLatitude  Float?    @map("clock_out_latitude")
  clockOutLongitude Float?    @map("clock_out_longitude")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  status            AttendanceStatus @default(hadir)
  reasonDescription String?          @db.Text
  proofFilePath     String?
  submittedAt       DateTime?
  validatedBy       Int?
  validatedAt       DateTime?

  // Relasi ke user
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("attendances")
}

/// Model Logbook
/// Menyimpan catatan harian aktivitas magang mahasiswa.
model Logbook {
  id      Int           @id @default(autoincrement())
  logDate DateTime      @map("log_date") @db.Date
  content String        @db.Text
  status  StatusLogbook @default(draft)

  // Relasi ke user
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("logbooks")
}

/// Model Task
/// Menyimpan data tugas yang diberikan kepada mahasiswa.
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String    @db.Text
  deadline    DateTime
  filePath    String?   @map("file_path")
  deletedAt   DateTime?

  // Relasi ke user sebagai pembuat tugas
  creator   User @relation("CreatedTasks", fields: [createdBy], references: [id])
  createdBy Int  @map("created_by")

  // Relasi ke pengumpulan tugas
  submissions Submission[]

  // Relasi ke penugasan tugas
  assignments TaskAssignment[]

  @@map("tasks")
}

/// Model TaskAssignment
/// Menyimpan relasi penugasan tugas ke mahasiswa (many-to-many).
model TaskAssignment {
  task   Task @relation(fields: [taskId], references: [id])
  taskId Int  @map("task_id")

  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@id([taskId, userId])
  @@map("task_assignments")
}

/// Model Submission
/// Menyimpan data pengumpulan tugas oleh mahasiswa.
model Submission {
  id          Int              @id @default(autoincrement())
  filePath    String?          @map("file_path")
  grade       Float?
  feedback    String?
  status      StatusSubmission @default(not_submitted)
  gradedBy    Int?
  gradedAt    DateTime?
  deletedAt   DateTime?
  isLate      Boolean          @default(false)
  description String?

  // Relasi ke tugas
  task   Task @relation(fields: [taskId], references: [id])
  taskId Int  @map("task_id")

  // Relasi ke user
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("submissions")
}

/// Model FinalProject
/// Menyimpan data tugas akhir mahasiswa.
model FinalProject {
  id          Int                @id @default(autoincrement())
  title       String
  description String?            @db.Text
  filePath    String?            @map("file_path")
  status      StatusFinalProject @default(draft)
  grade       Float?
  feedback    String?            @db.Text
  submittedAt DateTime?          @map("submitted_at")
  reviewedAt  DateTime?          @map("reviewed_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  // Relasi ke user sebagai mahasiswa
  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  // Relasi ke user sebagai reviewer
  reviewedBy   User? @relation("FinalProjectReviewer", fields: [reviewedById], references: [id])
  reviewedById Int?  @map("reviewed_by_id")

  @@map("final_projects")
}

/// Model Document
/// Menyimpan dokumen yang diunggah oleh user.
model Document {
  id       Int    @id @default(autoincrement())
  title    String
  filePath String @map("file_path")

  // Relasi ke user sebagai pengunggah
  uploader   User? @relation(fields: [uploadedBy], references: [id])
  uploadedBy Int?  @map("uploaded_by")

  @@map("documents")
}

/// Model AuditLog
/// Menyimpan log audit aktivitas penting dalam sistem.
model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entityId    Int
  userId      Int
  description String?
  createdAt   DateTime @default(now())
}

/// Model Notification
/// Menyimpan notifikasi yang dikirim ke user.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Model Certificate
/// Menyimpan data sertifikat magang mahasiswa.
model Certificate {
  id                Int               @id @default(autoincrement())
  certificateNumber String            @unique
  userId            Int               @unique
  internName        String
  educationalStatus String
  institusi         String
  predicate         String
  namaKegiatan      String
  activityPeriod    String
  tglSertifikat     DateTime
  namaKepalaBPS     String
  nipKepalaBPS      String
  templatePath      String
  signedFilePath    String?
  status            CertificateStatus @default(generated)
  generatedAt       DateTime          @default(now())
  signedAt          DateTime?
  issuedAt          DateTime?
  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relasi ke user penerima sertifikat
  user User @relation(fields: [userId], references: [id])

  @@map("certificates")
}
